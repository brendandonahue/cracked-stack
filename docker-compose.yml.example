services:
  example-nginx:
    image: nginx:alpine
    restart: unless-stopped
    volumes:
      - ./build:/usr/share/nginx/html:ro
      - ./nginx.conf:/etc/nginx/conf.d/default.conf:ro
    expose:
      - "80"
    networks:
      - app-net
    healthcheck:
      test: ["CMD", "curl", "-f", "http://localhost"]
      interval: 10s
      timeout: 5s
      retries: 3

  caddy:
    container_name: caddy
    image: caddy:2-alpine
    restart: unless-stopped
    ports: 
      - "80:80"
      - "443:443"
    volumes:
      - ./Caddyfile:/etc/caddy/Caddyfile:ro
      - caddy_data:/data
      - caddy_config:/config
    environment:
      - SVELTE_HOST=${SVELTE_HOST}
      - ROCKET_HOST=${ROCKET_HOST}
    networks:
      - app-net
    healthcheck:
      test: ["CMD", "curl", "-f", "http://localhost:2019/metrics"]
      interval: 10s
      timeout: 5s
      retries: 5
      start_period: 10s
  
  surrealdb:
    container_name: surrealdb
    image: surrealdb/surrealdb:latest
    restart: unless-stopped
    user: "root"
    environment:
      - SURREAL_USER=${SURREALDB_USER}
      - SURREAL_PASS=${SURREALDB_PASS}
      - SURREAL_LOG=${SURREAL_LOG:-info}     # fallback if not set
    command: >
      start 
      --log ${SURREAL_LOG} 
      --bind ${SURREAL_BIND} 
      ${SURREAL_DB_ENGINE}:${SURREAL_DB_PATH}
    expose:
      - "8001"
    volumes:
      - surreal-data:/data
    networks:
      - app-net
    healthcheck:
      test: ["CMD", "/surreal", "isready", "--endpoint", "http://localhost:8001"]
      interval: 15s
      timeout: 3s
      retries: 10
      start_period: 10s

  ollama:
    container_name: ollama
    image: ollama/ollama:latest
    restart: unless-stopped
    expose:
      - "11434"
    volumes:
      - ollama-data:/root/.ollama
    environment:
      - OLLAMA_HOST=${OLLAMA_HOST}
      - OLLAMA_ORIGINS=${OLLAMA_ORIGINS}
      - OLLAMA_DEBUG=${OLLAMA_DEBUG}
      - OLLAMA_KEEP_ALIVE=${OLLAMA_KEEP_ALIVE}
      - OLLAMA_MAX_LOADED_MODELS=${OLLAMA_MAX_LOADED_MODELS}
      - OLLAMA_NUM_PARALLEL=${OLLAMA_NUM_PARALLEL}
    networks:
      - app-net
    healthcheck:                  
      test: ["CMD", "ollama", "list"]
      interval: 10s
      timeout: 5s
      retries: 5
      start_period: 30s

  redis:
    container_name: redis
    image: redis:7.4-alpine
    restart: unless-stopped
    ports:
      - "6379:6379"          # host access if needed
    command: redis-server --save 60 1 --loglevel warning
    volumes:
      - redis_data:/data
    healthcheck:
      test: ["CMD", "redis-cli", "ping"]
      interval: 10s
      timeout: 5s
      retries: 5
    networks:
      - app-net

  broker:
    container_name: broker
    image: apache/kafka:latest
    restart: unless-stopped
    ports:
      - "9092:9092"
    volumes:
      - kafka_data:/kafka_data
    environment:
      KAFKA_NODE_ID: 1
      KAFKA_PROCESS_ROLES: broker,controller
      KAFKA_LISTENERS: PLAINTEXT://:9092,CONTROLLER://:9093
      KAFKA_ADVERTISED_LISTENERS: PLAINTEXT://localhost:9092
      KAFKA_CONTROLLER_LISTENER_NAMES: CONTROLLER
      KAFKA_LISTENER_SECURITY_PROTOCOL_MAP: CONTROLLER:PLAINTEXT,PLAINTEXT:PLAINTEXT
      KAFKA_CONTROLLER_QUORUM_VOTERS: 1@localhost:9093
      KAFKA_OFFSETS_TOPIC_REPLICATION_FACTOR: 1
      KAFKA_TRANSACTION_STATE_LOG_REPLICATION_FACTOR: 1
      KAFKA_TRANSACTION_STATE_LOG_MIN_ISR: 1
      KAFKA_GROUP_INITIAL_REBALANCE_DELAY_MS: 0
      KAFKA_NUM_PARTITIONS: 3
    healthcheck:
      test: ["CMD-SHELL", "kafka-topics.sh --bootstrap-server localhost:9092 --list"]
      interval: 30s
      timeout: 10s
      retries: 5
    networks:
      - app-net

  grafana:
    container_name: grafana
    image: grafana/grafana:latest
    restart: unless-stopped
    ports:
      - "3000:3000"
    volumes:
      - grafana_data:/var/lib/grafana
      - ./grafana/provisioning:/etc/grafana/provisioning
    environment:
      - GF_SERVER_ROOT_URL=https://${GF_SERVER_ROOT_URL}
      - GF_SERVER_SERVE_FROM_SUB_PATH=true
      - GF_SECURITY_ADMIN_PASSWORD=${GF_SECURITY_ADMIN_PASSWORD}
    healthcheck:
      test: ["CMD", "curl", "-f", "http://localhost:3000/api/health"]
      interval: 30s
      timeout: 10s
      retries: 5
      start_period: 60s
    networks:
      - app-net

  umami_db:
    container_name: umami_db
    image: postgres:16-alpine
    restart: unless-stopped
    volumes:
      - umami_db_data:/var/lib/postgresql/data
    environment:
      - POSTGRES_DB=${POSTGRES_DB}
      - POSTGRES_USER=${POSTGRES_DB}
      - POSTGRES_PASSWORD=${POSTGRES_PASSWORD}   # move to .env in prod
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U umami"]
      interval: 10s
      timeout: 5s
      retries: 5
    networks:
      - app-net

  umami:
    container_name: umami
    image: elestio/umami
    restart: unless-stopped
    depends_on:
      umami_db:
        condition: service_healthy
    expose:
      - "3000"
    environment:
      - DATABASE_URL=${DATABASE_URL}
      - APP_SECRET=${UMAMI_SECRET}
      - REDIS_URL=redis://redis:6379
    healthcheck:
      test: ["CMD", "curl", "-f", "http://localhost:3000/api/heartbeat"]
      interval: 30s
      timeout: 10s
      retries: 5
      start_period: 30s
    networks:
      - app-net

  surrealist:
    container_name: surrealist
    image: surrealdb/surrealist:latest
    restart: unless-stopped
    expose:
      - "8080"
    networks:
      - app-net

  example-rust-server:
    build:
      context: ./server
      dockerfile: ../Dockerfile.rust
    restart: unless-stopped
    expose:
      - "8000"
    environment:
      - ROCKET_ADDRESS=0.0.0.0
      - ROCKET_PORT=8000
      - ROCKET_LOG_LEVEL=normal
      - ROCKET_SECRET_KEY=${ROCKET_SECRET_KEY}
      - ROCKET_ENV=${ROCKET_ENV}
      - SURREALDB_HOST=${SURREALDB_HOST}
      - SURREALDB_PORT=${SURREALDB_PORT}
      - SURREALDB_USER=${SURREALDB_USER}
      - SURREALDB_PASS=${SURREALDB_PASS}
      - SURREALDB_NS=${SURREALDB_NS}
      - SURREALDB_DB=${SURREALDB_DB}
      - SMTP_HOST=${SMTP_HOST}
      - SMTP_PORT=${SMTP_PORT}
      - SMTP_USER=${SMTP_USER}
      - SMTP_PASS=${SMTP_PASS}
      - SMTP_FROM=${SMTP_FROM}
      - FRONTEND_URL=${FRONTEND_URL}
      - UPLOAD_DIR=/uploads
    networks:
      - app-net
    volumes:
      - uploads-volume:/uploads
    depends_on:
      surrealdb:
        condition: service_healthy
      ollama:
        condition: service_healthy
      caddy:
        condition: service_healthy
    healthcheck:
      test: ["CMD", "curl", "-f", "http://localhost:8000/health"]
      interval: 10s
      timeout: 5s
      retries: 3

networks:
  app-net:
    external: true

volumes:
  caddy_data:
  caddy_config:
  ollama-data:
  surreal-data:
  redis_data:
  kafka_data:
  grafana_data:
  umami_db_data:
  uploads-volume:
