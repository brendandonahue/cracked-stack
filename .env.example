# Cracked Stack — environment template
# Copy to .env (project root) for docker compose / deploy.sh.
# For local Rust dev, also copy server-related vars to server/.env (cargo does not load root .env by default).
# Never commit real secrets.

# --- Frontend (SvelteKit — must be PUBLIC_ for client) ---
PUBLIC_API_URL=http://127.0.0.1:8000

# --- SurrealDB ---
SURREALDB_HOST=127.0.0.1
SURREALDB_PORT=8001
SURREALDB_USER=root
SURREALDB_PASS=root
SURREALDB_NS=default
SURREALDB_DB=default

# --- Rocket ---
ROCKET_SECRET_KEY=change-me-to-a-long-random-string
ROCKET_ENV=development
ROCKET_ADDRESS=0.0.0.0
ROCKET_PORT=8000
ROCKET_LOG_LEVEL=normal

# --- Stripe (custom integration, see server/src/stripe.rs) ---
# Leave STRIPE_SECRET_KEY empty to disable checkout; /payments then shows a notice.
# Test-mode secret key from https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxx
# Signing secret of the webhook endpoint pointing at https://<ROCKET_HOST>/stripe/webhook
# (events: checkout.session.completed, checkout.session.async_payment_succeeded).
# Local dev: stripe listen --forward-to localhost:8000/stripe/webhook  (prints a whsec_ value)
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxx
# Where Stripe sends the customer back after checkout (falls back to FRONTEND_URL)
APP_BASE_URL=http://localhost:1420

# --- Email (password reset, invites) ---
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# From address for outgoing mail. Falls back to SMTP_USER if empty.
SMTP_FROM=noreply@example.com
# Optional display name shown to recipients (e.g. "Cracked Stack").
SMTP_FROM_NAME=
FRONTEND_URL=http://localhost:1420

# --- Ollama (customer service agent) ---
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_CS_MODEL=qwen3:14b
BACKUP_RSYNC_DEST=user@backup-server:/backups/cracked-stack/surrealdb

# --- iOS (Tauri) ---
# Your iPhone's UDID, used by `npm run ios:install`. Find it with: xcrun devicectl list devices
# Keep the real value in .env only (git-ignored); never commit it.
IOS_DEVICE_ID=