# Cracked Stack — environment template
# Copy to .env (project root) for docker compose / deploy.sh.
# For local Rust dev, also copy server-related vars to server/.env (cargo does not load root .env by default).
# Never commit real secrets.

# --- Frontend (SvelteKit — must be PUBLIC_ for client) ---
PUBLIC_API_URL=http://127.0.0.1:8000
PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxx

# --- SurrealDB ---
SURREALDB_HOST=127.0.0.1
SURREALDB_PORT=8001
SURREALDB_USER=root
SURREALDB_PASS=root
SURREALDB_NS=default
SURREALDB_DB=default

# --- Rocket ---
ROCKET_SECRET_KEY=change-me-to-a-long-random-string
ROCKET_ENV=development
ROCKET_ADDRESS=0.0.0.0
ROCKET_PORT=8000
ROCKET_LOG_LEVEL=normal

# --- Stripe ---
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxx
APP_BASE_URL=http://localhost:1420
# Essentials ($699/mo), Growth ($1,799/mo), Elite ($4,999/mo) — create in Stripe Dashboard
STRIPE_PRICE_STARTER=price_xxxxxxxxxxxxx
STRIPE_PRICE_GROWTH=price_xxxxxxxxxxxxx
STRIPE_PRICE_ELITE=price_xxxxxxxxxxxxx
STRIPE_PRICE_DISTRIBUTOR=price_xxxxxxxxxxxxx

# --- Email (password reset, invites) ---
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
FRONTEND_URL=http://localhost:1420

# --- Ollama (customer service agent) ---
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_CS_MODEL=qwen3:14b
BACKUP_RSYNC_DEST=user@backup-server:/backups/cracked-stack/surrealdb